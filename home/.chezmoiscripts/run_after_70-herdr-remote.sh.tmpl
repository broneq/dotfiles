#!/usr/bin/env bash
#
# Save the `owned` machine in herdr on the `managed` machine, once.
#
# `herdr machine add` has to reach the remote machine over SSH, and that needs
# two things no apply can supply: a Cloudflare Access login, which opens a
# browser, and this machine's key in the remote authorized_keys. Until both
# exist, the script says what is missing and exits 0, so that an apply on a
# machine that is not ready yet still converges everything else. Once the SSH
# probe succeeds, a failing `machine add` is a real error and fails the apply.

set -euo pipefail

# `run_after_`, not `run_onchange_after_`: the rendered text does not change when
# the Access login happens, so a run_onchange_ script that skipped once would
# never run again.

# `get`: a machine initialised before the tunnel prompt existed has no such key.
target={{ get . "tunnel_target" | quote }}
alias={{ .herdr_remote.ssh_alias | quote }}
label={{ .herdr_remote.label | quote }}

[ -n "$target" ] || exit 0

skip() {
	printf 'herdr remote %s: %s, skipping\n' "$label" "$1" >&2
	exit 0
}

command -v herdr >/dev/null 2>&1 || skip "herdr is not installed"
command -v cloudflared >/dev/null 2>&1 || skip "cloudflared is not installed"

# Matched on the saved SSH target, not the label: labels can be renamed in the
# UI, the target cannot.
if herdr machine list --json | grep -qF "\"$alias\""; then
	exit 0
fi

# `cloudflared access token` reads the cached login and never opens a browser.
# `cloudflared access ssh`, which the SSH probe below runs, would open one and
# block the apply waiting for it.
host="${target#*@}"
cloudflared access token -app="https://$host" >/dev/null 2>&1 ||
	skip "no Cloudflare Access login; run 'cloudflared access login https://$host'"

ssh -o BatchMode=yes -o ConnectTimeout=15 "$alias" true </dev/null ||
	skip "'ssh $alias' does not log in; add this machine's public key to authorized_keys on $label"

# stdin from /dev/null: setup answers No to replacing an incompatible remote
# server, which is its default and the only safe answer without a human.
herdr machine add --label "$label" "$alias" </dev/null
