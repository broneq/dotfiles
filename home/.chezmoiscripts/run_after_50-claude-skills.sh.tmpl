#!/usr/bin/env bash
#
# Restore the Claude Code agent skill set from .agents/.skill-lock.json.
# See docs/IMPLEMENTATION.md, "Skill restore", for why it is shaped this way.

set -euo pipefail

# There is no `skills` CLI on either machine: the lock file is written by an
# agent-side skill, not by a package manager, so restore has to be ours.
#
# The skill list is expanded into this script at template time, which means no jq
# at runtime and no dependency on the lock file having reached the destination yet.
#
# Plain run_after_, not run_onchange_: the trigger for a re-run is not "the lock
# file changed" but "a skill is not on disk in the version the lock file names",
# and only the destination knows that. run_onchange_ keys on the script text, so
# after `rm -rf ~/.claude` it saw nothing to do and thirteen skills stayed gone
# (defect 24). Every apply now checks each skill against the marker written next
# to its SKILL.md, and fetches only what is missing or out of date, so a converged
# machine costs thirteen file reads and no network.
#
# Two skills in ~/.agents/skills have no lock entry (create-tasks-workspace,
# no-mistakes) and are not restored here. See README.

agents_dir="$HOME/.agents/skills"
claude_dir="$HOME/.claude/skills"
bdk_dir="$HOME/projects/bdk"
failures=0

if ! command -v git >/dev/null 2>&1; then
	printf 'git not found; cannot restore skills.\n' >&2
	exit 1
fi

mkdir -p "$agents_dir" "$claude_dir"

cache="$(mktemp -d)"
trap 'rm -rf "$cache"' EXIT

# Four of the thirteen skills come from anthropics/claude-code. Cloning per skill
# would fetch the same repository four times.
clone_once() {
	local url slug dest
	url="$1"
	slug="$(printf '%s' "$url" | tr -c 'A-Za-z0-9' '_')"
	dest="$cache/$slug"
	if [ ! -d "$dest" ]; then
		git clone --quiet --depth 1 --filter=blob:none "$url" "$dest" >/dev/null 2>&1 || return 1
	fi
	printf '%s\n' "$dest"
}

install_skill() {
	local url skill_path folder hash checkout src marker
	url="$1"
	skill_path="$2"
	# The installed directory name is the slug of the lock file key, expanded at
	# template time. Deriving it from the path instead looks equivalent and is not:
	# "Writing Hookify Rules" lives at plugins/hookify/skills/writing-rules/, and a
	# restore keyed on the path silently renames the skill to `writing-rules`.
	folder="$3"
	# The lock file's skillFolderHash, recorded beside the copy. The copy is current
	# when the marker matches; the symlink is re-pointed either way, because
	# ~/.claude/skills can vanish on its own while ~/.agents/skills survives.
	hash="$4"
	marker="$agents_dir/$folder/.skill-lock-hash"

	if [ -f "$agents_dir/$folder/SKILL.md" ] \
		&& [ "$(cat "$marker" 2>/dev/null)" = "$hash" ]; then
		ln -sfn "../../.agents/skills/$folder" "$claude_dir/$folder"
		return 0
	fi

	if ! checkout="$(clone_once "$url")"; then
		printf 'skill %s: clone of %s failed\n' "$folder" "$url" >&2
		failures=$((failures + 1))
		return 0
	fi

	src="$checkout/$(dirname "$skill_path")"
	if [ ! -d "$src" ]; then
		printf 'skill %s: %s is not in %s\n' "$folder" "$skill_path" "$url" >&2
		failures=$((failures + 1))
		return 0
	fi

	rm -rf "${agents_dir:?}/$folder"
	cp -R "$src" "$agents_dir/$folder"
	printf '%s' "$hash" >"$marker"
	ln -sfn "../../.agents/skills/$folder" "$claude_dir/$folder"
	printf 'skill %s\n' "$folder"
}

{{ $lock := include "dot_agents/dot_skill-lock.json" | fromJson -}}
{{ range $name, $skill := $lock.skills -}}
install_skill "{{ $skill.sourceUrl }}" "{{ $skill.skillPath }}" "{{ $name | lower | replace " " "-" }}" "{{ $skill.skillFolderHash }}"
{{ end }}
# settings.json registers a plugin marketplace at a local directory. Without the
# clone, every bdk plugin fails to load, with an error that does not name this as
# the cause. Make the dependency explicit instead.
#
# HTTPS, not SSH: the repository is public, and an SSH remote would make a GitHub
# key an undeclared prerequisite of `chezmoi apply` on a machine that has none yet.
if [ ! -d "$bdk_dir/.git" ]; then
	printf 'plugin marketplace %s is missing; cloning\n' "$bdk_dir"
	mkdir -p "$(dirname "$bdk_dir")"
	if ! git clone --quiet https://github.com/broneq/bdk.git "$bdk_dir"; then
		printf 'clone of bdk failed. Clone it by hand and re-run chezmoi apply.\n' >&2
		failures=$((failures + 1))
	fi
fi

if [ "$failures" -gt 0 ]; then
	printf '%d skill restore step(s) failed.\n' "$failures" >&2
	exit 1
fi
