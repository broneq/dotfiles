#!/usr/bin/env bash
#
# Let each tool install its own Claude Code hook.
# See docs/IMPLEMENTATION.md, "Hooks belong to their tools".

set -euo pipefail

# The list of tools and their installers lives in packages.yaml under
# `agent_hooks`; this script names none of them. Every installer writes its own
# entry into ~/.claude/settings.json, and four of the five need no file on disk at
# all - the hook is just the command name. herdr is the exception: it ships a
# script and tracks its own version, which is precisely why versioning a copy of
# that script here was the wrong move.
#
# This is `run_after_`, not `run_onchange_after_`, and that is deliberate. A
# run_onchange_ script re-runs only when its own rendered text changes, and this
# script's text depends on nothing: it would execute exactly once in the lifetime
# of a machine. A tool installed later would never get its hook, and a tool that
# upgraded would keep serving the hook version it shipped with on day one. All
# five installers are idempotent and cheap, so running them on every apply is both
# safe and the only form that actually tracks the tools.
# Two of the five tools are npm globals under the nvm-managed node, which is not on
# PATH unless nvm has been sourced. Without this, `command -v` finds neither and
# both are reported as "not installed, skipping" - silently, with a zero exit. The
# first install.yml run is what surfaced it.
#
# NVM_DIR is exported before the source, not after. Homebrew's nvm.sh shim opens
# with `[ -z "$NVM_DIR" ] && export NVM_DIR=...`, which is an unbound dereference
# under `set -u` and aborts the whole script. An interactive shell never hits it
# because .zshrc has already exported the variable; a CI runner has not.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"

nvm_sh=""
if command -v brew >/dev/null 2>&1; then
	nvm_sh="$(brew --prefix)/opt/nvm/nvm.sh"
fi
if [ -n "$nvm_sh" ] && [ -s "$nvm_sh" ]; then
	# shellcheck disable=SC1090  # path is resolved at runtime, not knowable statically
	. "$nvm_sh"
	nvm use --silent default >/dev/null 2>&1 ||
		nvm use --silent node >/dev/null 2>&1 || true
fi

install_hook() {
	local tool="$1"
	shift
	if ! command -v "$tool" >/dev/null 2>&1; then
		printf 'hook: %s is not installed, skipping\n' "$tool" >&2
		return 0
	fi
	# `$tool` was shifted off `$@` above; it must be put back in front. Without it
	# the command run is `integration install claude`, which does not exist, and
	# every installer reports failure on every apply.
	if "$tool" "$@" >/dev/null 2>&1; then
		printf 'hook: %s\n' "$tool"
	else
		printf 'hook: %s failed to install its hook (%s %s)\n' "$tool" "$tool" "$*" >&2
	fi
}

{{ range .packages.agent_hooks -}}
install_hook {{ .tool | quote }}{{ range .args }} {{ . | quote }}{{ end }}
{{ end -}}
