#!/usr/bin/env bash
#
# Python CLI tools installed as isolated uv tools.
#
# uv is declared as a Homebrew formula, so 10-brew normally installs it first.
# The curl below is a fallback for a machine where that did not happen; it is the
# only script this repository downloads and executes, confined to this one
# guarded branch.

set -euo pipefail

if ! command -v uv >/dev/null 2>&1; then
	if [ -x "$HOME/.local/bin/uv" ]; then
		export PATH="$HOME/.local/bin:$PATH"
	else
		printf 'uv not found - bootstrapping from astral.sh\n'
		curl -LsSf https://astral.sh/uv/install.sh | sh
		export PATH="$HOME/.local/bin:$PATH"
	fi
fi

if ! command -v uv >/dev/null 2>&1; then
	printf 'uv bootstrap failed; not installing uv tools.\n' >&2
	exit 1
fi

{{ range .packages.uv -}}
uv tool install --upgrade "{{ . }}"
{{ end -}}
