#!/bin/sh
#
# Merge the settings this repository owns into ~/.claude/settings.json.
#
# A `modify_` script receives the current target file on stdin and writes the new
# content to stdout, so chezmoi never overwrites the file wholesale. That matters
# here because settings.json has two authors:
#
#   - this repository: model, plugins, marketplaces, status line, TUI preferences
#   - the installed tools: the `hooks` block is written by `herdr integration
#     install`, `atuin hook install`, `rtk init`, `gh-axi setup hooks` and
#     `chrome-devtools-axi setup hooks`; `autoMode` is generated by Claude Code
#     itself and describes whichever project it was configured against
#
# Copying the whole file into the repository would version the second author's
# output, which then goes stale, leaks project detail into a toolbox repo, and
# gets reverted every time chezmoi applies. Merging keeps each author's part.

set -eu

current="$(cat)"
[ -n "$current" ] || current='{}'

# Without jq, pass the file through untouched. Destroying settings because a
# dependency is missing is far worse than not applying this change.
if ! command -v jq >/dev/null 2>&1; then
	printf '%s' "$current"
	exit 0
fi

# `extraKnownMarketplaces` plus `enabledPlugins` is the whole plugin install
# mechanism: Claude Code syncs ~/.claude/plugins/installed_plugins.json against
# the `enabledPlugins` of every settings.json on startup and installs what is
# missing. A `claude plugin install` step in a run_onchange_ script would be an
# imperative duplicate of this declaration, and its output - absolute install
# paths and commit SHAs - is runtime state this repository must not version.
#
# Every marketplace an enabled plugin comes from has to be declared here, so the
# two lists are kept in step: `claude-plugins-official` has no entry because no
# plugin of its own is enabled any more, and it is also the one marketplace Claude
# Code auto-installs by itself. A plugin listed `false` is not declared at all -
# one that was never installed is already disabled, so the entry would only be a
# comment. Those decisions live in docs/ROADMAP.md instead.
printf '%s' "$current" | jq --sort-keys '. * {
  "model": "opus",
  "tui": "fullscreen",
  "cleanupPeriodDays": 730,
  "autoCompactWindow": 500000,
  "autoMemoryEnabled": false,
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "skipAutoPermissionPrompt": true,
  "permissions": { "defaultMode": "auto" },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0
  },
  "enabledPlugins": {
    "bdk@bdk": true,
    "caveman@caveman": true,
    "git-identity@bdk": true
  },
  "extraKnownMarketplaces": {
    "bdk": {
      "source": { "source": "directory", "path": "{{ .chezmoi.homeDir }}/projects/bdk" }
    },
    "caveman": {
      "source": { "source": "github", "repo": "JuliusBrussee/caveman" }
    }
  }
}'
