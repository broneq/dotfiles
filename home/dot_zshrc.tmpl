# Interactive shell configuration.
#
# Rule for this file: it must start cleanly on a machine where nothing is
# installed yet. Every source is guarded by an existence test, and no absolute
# home path is written out - two usernames exist across the two machines.
#
# Homebrew's PATH is set exactly once, by `brew shellenv` in .zprofile. Setting it
# here as well was a duplicate that silently reordered PATH on every new shell.

export PATH="$HOME/.local/bin:$PATH"

# uv writes this file when it bootstraps itself. Unguarded, it aborts the whole
# shell on a machine where uv has not been installed yet.
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# bun: required by the Claude Code status line (`bunx -y ccstatusline@latest`).
# Declared in packages.yaml; ~/.bun survives from the pre-Homebrew install.
export BUN_INSTALL="$HOME/.bun"
[ -d "$BUN_INSTALL/bin" ] && export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && . "$BUN_INSTALL/_bun"

# nvm. Roadmap phase 7 replaces this with mise; until then the five *-axi tools
# resolve from here and this block is load-bearing.
#
# `--no-use` is the point of this block's shape. Sourcing nvm.sh plainly also runs
# nvm_auto, which is `nvm use default` on every interactive shell: measured at
# 1.1 s out of a 1.5 s startup, and paid again by every subshell a program spawns
# (mc opens one per panel). `--no-use` skips it and leaves nvm a function to call
# when a version actually needs switching.
export NVM_DIR="$HOME/.nvm"
if [ -n "${HOMEBREW_PREFIX:-}" ]; then
	[ -s "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" ] && . "$HOMEBREW_PREFIX/opt/nvm/nvm.sh" --no-use
	[ -s "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm" ] && . "$HOMEBREW_PREFIX/opt/nvm/etc/bash_completion.d/nvm"
fi

# With --no-use nothing put node on PATH, so do it here without nvm's resolver -
# every entry point into that resolver costs the same 0.8 s the flag just saved.
# The alias file holds whatever `nvm alias default` prints. `30-npm-global` pins
# it to a bare major ("24"); the `n` glob qualifier sorts numerically, so [-1] is
# v24.21.0 and not v24.9.0. An alias the glob cannot expand (lts/*, which
# `nvm install --lts` writes on its own; a version never installed) falls through
# to nvm itself: correct, and slow only in that case.
if command -v nvm >/dev/null 2>&1; then
	if read -r _nvm_default 2>/dev/null <"$NVM_DIR/alias/default"; then
		_nvm_bin=("$NVM_DIR"/versions/node/"v${_nvm_default}"*/bin(N/n[-1]))
	fi
	if [ -n "${_nvm_bin[1]:-}" ]; then
		export PATH="${_nvm_bin[1]}:$PATH"
	else
		nvm use --silent default >/dev/null 2>&1
	fi
	unset _nvm_default _nvm_bin
fi

# atuin: shell history. The env file exists only after a standalone install; the
# Homebrew formula puts the binary on PATH instead, so test for both.
[ -f "$HOME/.atuin/bin/env" ] && . "$HOME/.atuin/bin/env"
command -v atuin >/dev/null 2>&1 && eval "$(atuin init zsh --disable-up-arrow)"

alias ccs='claude --dangerously-skip-permissions'

# Machine-local additions. Sourced last so they can override anything above.
# chezmoi creates the file once (create_ prefix) and never touches it again, so
# per-machine aliases and paths live there without ever entering this repository.
[ -f "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
